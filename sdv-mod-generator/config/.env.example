# ============================================
# LLM Provider Configuration
# ============================================
# Choose ONE provider: openai OR anthropic

# --- OpenAI (MiniMax OpenAI-compatible) ---
OPENAI_API_KEY=sk-cp-...
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_MODEL=MiniMax-M2.7

# --- Anthropic (comment out OpenAI vars above) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Fallback (optional) ---
# FALLBACK_LLM_PROVIDER=openai  # openai | anthropic

# ============================================
# Image Generation (AI sprite generator)
# ============================================
# The sprite phase (prompt -> image API -> downsample+quantize -> 16x16
# pixel-art sprite) uses a separate image provider from the text LLM above.
# Choose ONE: minimax (image-01 -> JPEG) or openai (gpt-image-1.5 -> PNG).
# NOTE: when OPENAI_BASE_URL above points at MiniMax (api.minimaxi.com), the
# `openai` provider does NOT work — MiniMax's endpoint serves chat (M2.7),
# not gpt-image-1.5. Use `minimax` with the MINIMAX_API_KEY in that setup.
SPRITE_IMAGE_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# --- OpenAI image (only when OPENAI_BASE_URL is a real OpenAI image endpoint) ---
# SPRITE_IMAGE_PROVIDER=openai
# Set SPRITE_DETERMINISTIC=1 to skip the image API entirely (a fixed
# 16x16 sample) — used by tests and the no-key load gate.

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sdv_mods

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# S3 Storage (local-only for dev — no credentials needed)
# ============================================
# Auto-detected: if AWS_ACCESS_KEY_ID is empty, uses local filesystem mode.
# Zips written to LOCAL_OUTPUT_DIR, served as file:// URLs.
LOCAL_OUTPUT_DIR=/tmp/sdv-mod-generator/outputs
S3_BUCKET=sdv-mod-generator
S3_REGION=us-east-1

# For real S3: set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY + optional S3_BUCKET/S3_REGION
# For LocalStack: AWS_ACCESS_KEY_ID=localstack AWS_SECRET_ACCESS_KEY=localstack AWS_ENDPOINT_URL=http://localhost:4566

# ============================================
# Discord
# ============================================
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
# Optional: guild id to sync slash commands to during dev (instant).
# Unset = global sync (can take up to an hour to propagate).
DISCORD_SYNC_GUILD_ID=
# Webhook path (HTTP interactions) — required only for the webhook fallback.
DISCORD_PUBLIC_KEY=

# ============================================
# Security
# ============================================
# API key for authenticating API requests (optional — only required for production)
# If not set, API endpoints are open (not recommended for production)
API_KEY=

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
