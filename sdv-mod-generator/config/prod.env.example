# =============================================================================
# Production environment variables
# =============================================================================
# This file documents the env vars a production deploy MUST set. Do NOT
# commit actual values — source them from your secrets manager (AWS
# Secrets Manager, GCP Secret Manager, HashiCorp Vault, 1Password CLI, etc.)
# and inject them into the container at startup.
#
# To rotate the Discord token in production:
#   make rotate-token         (calls scripts/rotate_token.sh)
#
# To verify nothing leaked to a plain .env on a prod host:
#   APP_ENV=prod ./scripts/check_no_plaintext_secrets.sh /etc/sdv-mod-generator/env
# =============================================================================

# Runtime mode — REQUIRED. Setting this disables auto-loading of config/.env.
APP_ENV=prod

# ---------- LLM provider (set one of the two) ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_MODEL=MiniMax-M2.7
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---------- Image generation (optional — AI sprite phase) ----------
# Separate provider from the text LLM above. Choose minimax (image-01 ->
# JPEG, needs Pillow) or openai (gpt-image-1.5 -> PNG). When
# OPENAI_BASE_URL points at MiniMax (api.minimaxi.com), use `minimax` —
# the `openai` provider needs a real OpenAI image endpoint.
# SPRITE_IMAGE_PROVIDER=minimax
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# ---------- Database (required) ----------
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/sdv_mods

# ---------- Redis (required) ----------
REDIS_URL=redis://<host>:6379/0

# ---------- S3 / object storage (required in prod — local mode is dev only) ----------
S3_BUCKET=sdv-mod-generator
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: S3-compatible endpoint (MinIO, R2, B2, etc.)
# S3_ENDPOINT_URL=https://minio.example.com

# ---------- Discord (required) ----------
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=

# ---------- API auth (required in prod) ----------
# Long random string. Generate with: openssl rand -hex 32
API_KEY=
API_OWNER_USER_ID=

# ---------- Observability ----------
LOG_LEVEL=INFO
